{
  "name": "pi-in-the-sky",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "projects/macos"
  ],
  "type": "module",
  "scripts": {
    "fallow": "fallow dead-code --production --type-aware --fail-on-issues && fallow dead-code --test-only-exports --type-aware --fail-on-issues && fallow dupes --fail-on-issues",
    "deploy": "bun run --cwd services/cfw-agent deploy",
    "test": "bun run --filter '@pi-in-the-sky/cfw-agent' test",
    "typecheck": "bun check -b"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fallow": "^3.50.0",
    "fallow-type-aware": "3.50.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
