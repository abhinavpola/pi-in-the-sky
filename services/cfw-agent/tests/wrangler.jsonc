{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pi-in-the-sky-agent-test",
  "main": "./worker.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "PersonalAgent",
        "class_name": "TestPersonalAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TestPersonalAgent"],
    },
  ],
}
